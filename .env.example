APP_NAME=HASEM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hasem
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production:
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Production (recommended): Redis for queue, cache, and sessions.
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_CLIENT=phpredis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
EMAIL_FROM="noreply@example.com"
CENTRAL_EMAIL_MAILER=resend
RESEND_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS for mobile/SPA (leave empty unless a browser SPA calls the API cross-origin)
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

AI_DEFAULT_PROVIDER=google_ai_studio

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=512

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PERMANENT_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI="${APP_URL}/workspace/channels"

PAYMENT_DEFAULT_PROVIDER=local
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
LOCAL_PAYMENT_WEBHOOK_SECRET=
LOCAL_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# HyperPay — platform subscription placeholder + merchant settlement (not live marketplace/split)
HYPERPAY_ENABLED=false
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_MERCHANT_ONBOARDING_ENABLED=false
# Staging/tests only — never enable in production
HYPERPAY_MERCHANT_SANDBOX_AUTO_APPROVE=false

WEBSITE_PLATFORM_DOMAIN=
WEBSITE_DNS_TARGET=
WEBSITE_DNS_TARGET_TYPE=A
WEBSITE_DNS_TTL=300
WEBSITE_DNS_WWW_TARGET=@
WEBSITE_PREVIEW_URL_TTL_MINUTES=120
WEBSITE_RESOLVER_CACHE_TTL_SECONDS=300
WEBSITE_PUBLIC_RATE_LIMIT=60,1
WEBSITE_DOMAIN_SEARCH_TLDS=com,net,org,clinic,care,health,law,pro
WEBSITE_DOMAIN_MARKUP_PERCENT=0
WEBSITE_DOMAIN_VERIFICATION_RETRY_SECONDS=600
WEBSITE_DOMAIN_VERIFICATION_MAX_ATTEMPTS=12
WEBSITE_DOMAIN_PRICING_CACHE_SECONDS=21600
WEBSITE_DOMAIN_AUTO_RENEW_DAYS_BEFORE=14
WEBSITE_DOMAIN_EXPIRATION_REMINDER_DAYS=30,14,7,3,1

WEBSITE_SSL_ENABLED=false
WEBSITE_SSL_DRIVER=certbot
WEBSITE_SSL_CERTBOT_BIN=certbot
WEBSITE_SSL_EMAIL=
WEBSITE_SSL_WEBROOT=/var/www/certbot
WEBSITE_SSL_LIVE_PATH=/etc/letsencrypt/live
WEBSITE_SSL_INCLUDE_WWW=true
WEBSITE_SSL_RELOAD_COMMAND="systemctl reload nginx"
WEBSITE_SSL_COMMAND_TIMEOUT=180
WEBSITE_SSL_RENEW_DAYS_BEFORE=30

NAMECHEAP_ENV=sandbox
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_TIMEOUT=20
NAMECHEAP_CONNECT_TIMEOUT=8

# Hasim mobile — push (FCM). Disabled until credentials are set.
FCM_ENABLED=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Realtime: use log locally; production should use redis/reverb/pusher
# BROADCAST_CONNECTION=log

PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_EMAIL=admin@hasem.local
PLATFORM_ADMIN_PASSWORD=password
